{
  "name": "project-world-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "prebuild": "node scripts/check-meta.mjs && node scripts/check-house-rules.mjs && node scripts/generate-mono-tokens.mjs --check",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postbuild": "node scripts/prerender.mjs && node scripts/inline-critical.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs && node scripts/check-seo.mjs",
    "knip": "knip",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:app": "playwright test --config playwright.app.config.js",
    "lighthouse": "node scripts/generate-lighthouse-urls.mjs && lhci autorun",
    "check:meta": "node scripts/check-meta.mjs",
    "check:house-rules": "node scripts/check-house-rules.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@zxing/library": "^0.23.0",
    "axios": "^1.21.1",
    "client-zip": "^2.5.1",
    "exifr": "^7.1.3",
    "hls.js": "^1.7.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-ga4": "^2.1.0",
    "react-head": "^3.4.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.5",
    "tus-js-client": "^4.3.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "beasties": "^0.5.5",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "26.1.0",
    "knip": "^6.24.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7",
    "vitest": "4.1.12"
  }
}
