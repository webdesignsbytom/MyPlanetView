# 0) One host: www goes to the bare domain in one hop (match FULL_BUSINESS_URL)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule (.*) https://%1%{REQUEST_URI} [L,R=301]

# 1) Force HTTPS (keep)
RewriteCond %{HTTPS} !on
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) and 3) come before the pages' rules (4): mod_rewrite runs this file's rules as one
# list, and section 4's [L] rules end it for every page and file, so anything after them
# only ever reached addresses nothing else matched

# 2) Limit HTTP methods (keep)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD|OPTIONS)$
  RewriteRule .* - [F]
</IfModule>

# 3) Simple bot ban (no generic words like "crawler": real search bots use them)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} (badbot|spambot) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# 4) Pre-rendered pages (<route>.html), the app shell for browser-only pages, a real 404 for the rest
Options -Indexes
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^(index|404|app-shell)\.html$ - [L]

  # Never rewrite static assets
  RewriteRule ^assets/ - [L]
  RewriteRule \.(js|mjs|css|map|json|txt|xml|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot|mp4|mov|webm)$ - [L,NC]

  # /about/ -> /about (one URL per page)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about -> about.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule . - [L]

  # Browser-only pages (filled in at build from CLIENT_ONLY_ROUTE_PREFIXES)
  #__CLIENT_ONLY_REWRITES__
</IfModule>
ErrorDocument 404 /404.html

# 5) Security headers (keep)
# CSP: no inline script anywhere (the pages' only inline <script>s are JSON-LD, which is
# data, not code), so script-src has no 'unsafe-inline'. style-src keeps it for React's
# style attributes. Forms only post to this site (the app sends its data with fetch/XHR).
# Outside hosts (17 Nov 2026, the live test; client/netlify.toml sends the same): the API
# (my-planet-view.vercel.app until it moves to api.<domain>); the public bucket's r2.dev
# address (posters, landmark and festival photos); the private bucket's R2 endpoint (signed
# photo links and presigned uploads); Cloudflare Stream (video playback, thumbnails, tus
# uploads). The bucket and Stream hosts are whole Cloudflare domains, as their exact names
# live in the env files: narrow them to the real ones, and add a custom media domain if
# VITE_MEDIA_CDN becomes one (docs/AUDIT.md, D1). worker-src allows blob: for hls.js.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; \
    script-src 'self' https://www.googletagmanager.com; \
    style-src  'self' 'unsafe-inline'; \
    font-src   'self'; \
    img-src    'self' https://*.r2.dev https://*.eu.r2.cloudflarestorage.com https://*.cloudflarestream.com data: blob:; \
    connect-src 'self' \
      https://my-planet-view.vercel.app \
      https://*.r2.dev https://*.eu.r2.cloudflarestorage.com \
      https://*.cloudflarestream.com https://upload.videodelivery.net \
      https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; \
    media-src  'self' https://*.cloudflarestream.com https://*.eu.r2.cloudflarestorage.com blob: data:; \
    worker-src 'self' blob:; \
    form-action 'self'; \
    frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options DENY
  # The old XSS filter is gone from current browsers and could be abused where it's left: off
  Header always set X-XSS-Protection "0"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # geolocation for this site only: a moment's pin can come from the device's location
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  # Pages from other sites opened from here (or opening this site) get no handle on its windows
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HTTPS only, for a year, subdomains included (so every subdomain must serve HTTPS: the
  # API, mail, cPanel's own). Not "preload": that is hard to undo; add it only once sure.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 6) Compression (Brotli, Gzip fallback) + Vary
# The types must match what section 8 serves: .js and .mjs go out as text/javascript, and
# TravelFont is a .ttf (font/ttf), which compresses by about a third (woff2 is already compressed).
<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml font/ttf
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml font/ttf
</IfModule>

<IfModule mod_headers.c>
  # Ensure correct caching per encoding
  Header append Vary Accept-Encoding
</IfModule>

# 7) Access hardening (keep)
<FilesMatch "\.(htaccess|htpasswd|env|ini|log|sh|php)$">
  Require all denied
</FilesMatch>

# 8) Charset + MIME types (keep)
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/javascript .mjs
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/vnd.ms-fontobject .eot
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType video/mp4 .mp4
  AddType video/quicktime .mov
  AddType video/webm .webm
</IfModule>

# 9) Caching
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML revalidates
  ExpiresByType text/html "access plus 0 seconds"

  # Hashed static assets
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/quicktime "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Non-hashed metadata
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  # (covers robots.txt, sitemap.xml via their MIME on many hosts)
</IfModule>

<IfModule mod_headers.c>
  # Static files (these Cache-Control headers win over the Expires headers above).
  # Only Vite's build output under /assets/ has a content hash in its name, so only it is
  # cached for good. Everything copied from public/ (favicon/, brand/, pages/...) keeps
  # its name when it changes, so browsers check it again after a day.
  <FilesMatch "\.(css|js|mjs|svg|avif|webp|jpg|jpeg|png|gif|ico|woff2?|ttf|mp4|mov|webm)$">
    Header set Cache-Control "public, max-age=86400"
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
  </FilesMatch>

  # HTML must revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The service worker (PWA): always checked, so a new deploy replaces it at once (after
  # the .js rule above, so this one wins)
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Metadata files (non-hashed) — short cache
  <FilesMatch "^(manifest\.json|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# 10) PHP handler (keep)
# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit