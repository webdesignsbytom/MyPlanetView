generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ── Accounts (better-auth owns these four; unchanged from the dummy) ─────────
// Their ids are UUIDs like every other table's (17 Nov 2026, the user's wish): auth.js sets
// `advanced.database.generateId: 'uuid'`, so better-auth leaves the id out on Postgres and
// Prisma's @default(uuid()) fills it in (AuthRateLimit's too). Rows made before then keep
// better-auth's own random ids.

model User {
  id            String    @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  role          String    @default("USER")

  // Admin can deactivate (blocks sign-in and sessions)
  isActive Boolean @default(true)

  profile         Profile?
  avatarMediaItem AvatarMediaItem?
  mediaItems      MediaItem[]

  // Travel
  ownedMaps         TravelMap[]
  mapMemberships    MapMember[]
  tripMemberships   TripMember[]
  createdTrips      Trip[]
  uploadedPhotos    Photo[]
  sentShareInvites  ShareInvite[]
  travellerOf       Traveller[]
  addedTripLinks    TripMap[]
  createdMoments    Moment[]
  createdGoals      Goal[]
  // Photos this user entered in a monthly theme
  themeEntries      PhotoThemeEntry[]
  // Friends challenges this user started, and the ones they're in
  startedChallenges FriendChallenge[]      @relation("ChallengeCreator")
  challengeEntries  FriendChallengeEntry[]

  // Influencer codes this admin made (docs/API.md, "Promo codes")
  createdPromoCodes PromoCode[]

  // App events
  actedAppEvents    AppEvent[] @relation("AppEventActor")
  targetedAppEvents AppEvent[] @relation("AppEventTarget")

  // Plans (docs/API.md, "Plans and billing"): kept off this table, which better-auth
  // reads on every request
  subscription Subscription?
  planGrants   PlanGrant[]   @relation("PlanGrantUser")
  grantedPlans PlanGrant[]   @relation("PlanGrantGrantedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// One per login. The people a map is for (solo, couple, family) are Travellers
// on the map, not fields here. Gender, hobbies, Instagram id and hashtags from
// the old setup form are gone.
model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username String? @unique

  // Shown as "home" on the map
  homeCountryCode String?  @db.Char(2)
  homeCountry     Country? @relation(fields: [homeCountryCode], references: [code], onDelete: SetNull)

  // How this user likes to view maps: style (animated, old map), grid lines,
  // sea animation, sun and moon, country names...
  // Was localStorage-only before.
  mapSettings Json?

  // What to do with this person's maps and photos when they delete their account
  // (PUT /api/users/leaving-plan): { maps: [{ mapId, action, toUserId? }], leavePhotos }.
  // Used only if saved within LEAVING_PLAN_TTL_MINUTES of the deletion.
  leavingPlan   Json?
  leavingPlanAt DateTime?

  // The influencer code this account signed up with (docs/API.md, "Promo codes"), and
  // when its free month started (a Stripe trial on its first paid Checkout; never twice)
  promoCodeId      String?
  promoCode        PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoTrialUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sign-ups per code (the admin's list); also the foreign key's SET NULL
  @@index([promoCodeId])
  @@map("profile")
}

// ── Reference data (seeded, never edited by users) ───────────────────────────

enum Continent {
  AFRICA
  ANTARCTICA
  ASIA
  EUROPE
  NORTH_AMERICA
  OCEANIA
  SOUTH_AMERICA
}

// COUNTRY: the 224 countries (ISO codes, plus IC Canary Islands and XK Kosovo).
// SPECIAL: places worth marking that aren't countries, left out of the country count
// (docs/SITE-DESIGN.md, "Special places"): Antarctica (AQ, a shape, the 7th continent)
// and the four poles (XN, QN, XS, QS: points, codes from ISO's user-assigned range).
enum PlaceKind {
  COUNTRY
  SPECIAL
  // The UK's nations (England XE, Scotland XC, Wales XW, Northern Ireland XI): in place of
  // GB on a map that splits the UK (TravelMap.splitUk; utils/ukNations.js)
  NATION
  // Part of a country, with its own visit (Bali, the Galapagos, Goa, Hawaii, New Caledonia,
  // Tasmania: utils/regionPlaces.js, which names each one's country); never counted as one
  REGION
}

model Country {
  code      String     @id @db.Char(2) // ISO 3166-1 alpha-2, e.g. "JP"
  name      String     @unique
  slug      String     @unique
  kind      PlaceKind  @default(COUNTRY)
  // Null for the North Pole and the magnetic poles, which are on no continent
  continent Continent?

  // Pin position on the SVG map (Robinson: the countries span y 0 to 857, the pole
  // lines are at -16.6 and 1020.6)
  pinX Float?
  pinY Float?

  landmarks    Landmark[]
  visits       CountryVisit[]
  tripStops    TripStop[]
  photos       Photo[]
  homeProfiles Profile[]
  moments      Moment[]
  offers       AffiliateOffer[]

  birthTravellers     Traveller[] @relation("TravellerBirthCountry")
  favouriteTravellers Traveller[] @relation("TravellerFavouriteCountry")

  @@map("country")
}

model Landmark {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  // The Wikidata item the coordinates were checked against (e.g. "Q5788"). The
  // reference loader upserts by it, so renaming a landmark updates its row.
  wikidataId String @unique

  countryCode String  @db.Char(2)
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  // Real-world position, used only to match photos by their GPS
  latitude     Float
  longitude    Float
  // A photo taken within this distance is suggested as a match
  matchRadiusM Int   @default(500)

  // Where the pin sits on the SVG map. No projection maths: set by hand or
  // seeded, the same way the old pinX/pinY were.
  pinX Float?
  pinY Float?

  // A UNESCO World Heritage Site (the passport and its badges): the inscriptions in
  // seed/data/landmarksUnesco.js, and the landmarks.js items in UNESCO_IN_EXISTING
  isUnesco Boolean @default(false)

  photoMatches PhotoLandmark[]
  tripStops    TripStop[]
  moments      Moment[]
  covers       LandmarkCover[]

  @@index([countryCode])
  @@index([latitude, longitude])
  @@map("landmark")
}

// ── Maps and sharing ─────────────────────────────────────────────────────────

enum ShareRole {
  VIEWER
  EDITOR
}

enum LinkAccess {
  RESTRICTED // only people added by email
  ANYONE_WITH_LINK // anyone with the share code can view; no sign-in needed
}

enum TravelGroupType {
  SOLO
  COUPLE
  FAMILY
}

// A travel map: the shared space for one traveller, a couple or a family.
// Set up at sign-up (pick solo, couple or family, then add the travellers).
// A couple or family can share one login, or each adult signs in with their
// own and is added as EDITOR (recommended: everyone uploads from their own
// phone, and nobody's photos are stuck behind someone else's password).
model TravelMap {
  id        String          @id @default(uuid())
  name      String // e.g. "Tom & Sarah's travels"
  groupType TravelGroupType @default(SOLO)
  isDefault Boolean         @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // The owner's id on their default map, null on every other map. Unique, so two
  // requests making a default map at once can't both succeed. A CHECK in the
  // migration keeps it equal to ownerId exactly when isDefault is true.
  defaultForOwnerId String? @unique

  linkAccess LinkAccess @default(RESTRICTED)
  // Random, unambiguous characters, e.g. K7QX-M2PA-9RTW. Reset = new code.
  // Lookups by code are rate limited.
  shareCode  String     @unique

  // A map handed to someone with no free map slot stays fully usable until then
  // (TRANSFER_GRACE_DAYS); after it, it needs paying for as an extra map or it's
  // locked (no new photos). Never cleared: a map that came this way queues behind
  // the owner's own maps for paid slots (utils/mapSlots.js).
  graceUntil DateTime?

  // The UK as its four nations (England, Scotland, Wales, Northern Ireland) instead of
  // one country, for everyone on the map (docs/API.md "The UK's nations"). On by default
  // for new maps (18 Nov 2026, the user's wish); changing it moves the map's UK visits,
  // photos, trip stops and moments (services/travel/ukNations.js).
  splitUk        Boolean @default(true)
  // The nations' visits as they were when the split was last turned off, put back if it's
  // turned on again while the map still has the UK; null otherwise
  ukNationVisits Json?

  travellers Traveller[]
  members    MapMember[]
  visits     CountryVisit[]
  trips      Trip[]
  photos     Photo[]
  invites    ShareInvite[]
  // Group trips from other people's maps shown on this one ("Add to my map")
  tripLinks  TripMap[]
  moments    Moment[]

  // The passport, badges and goals (docs/API.md, "Passport", "Badges and goals")
  landmarkMatches  PhotoLandmark[]
  landmarkCovers   LandmarkCover[]
  badges           BadgeAward[]
  goals            Goal[]
  // Its photos entered in the monthly themes (docs/API.md, "Photo themes")
  themeEntries     PhotoThemeEntry[]
  // Friends challenges it counts for (docs/API.md, "Friends challenges")
  challengeEntries FriendChallengeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("travel_map")
}

// A person the map is for: the solo traveller, each half of a couple, each
// member of a family. Needs no login (children, a partner who never signs in);
// linked to a User when that person has their own account.
model Traveller {
  id       String    @id @default(uuid())
  mapId    String
  map      TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name     String // the name to show, e.g. "Sarah"
  position Int       @default(0) // order on the map's traveller list

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  birthCountryCode     String?  @db.Char(2)
  birthCountry         Country? @relation("TravellerBirthCountry", fields: [birthCountryCode], references: [code], onDelete: SetNull)
  favouriteCountryCode String?  @db.Char(2)
  favouriteCountry     Country? @relation("TravellerFavouriteCountry", fields: [favouriteCountryCode], references: [code], onDelete: SetNull)

  trips   TripTraveller[]
  moments MomentTraveller[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One traveller per account on a map (rows with no login are unaffected)
  @@unique([mapId, userId])
  @@index([mapId, position])
  @@index([userId])
  @@map("traveller")
}

// People added to a map (the owner is not a row here)
model MapMember {
  mapId  String
  map    TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   ShareRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([mapId, userId])
  @@index([userId])
  @@map("map_member")
}

// Adding someone by email who has no account yet. Turned into a MapMember or
// TripMember when they sign up and verify that address. An existing user is
// added straight away and just gets an email.
model ShareInvite {
  id    String    @id @default(uuid())
  email String // lower-cased
  role  ShareRole @default(VIEWER)

  mapId  String?
  map    TravelMap? @relation(fields: [mapId], references: [id], onDelete: Cascade)
  tripId String?
  trip   Trip?      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  // The emailed link's token, stored hashed
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  // Foreign keys: a cascade from a deleted map, trip or user finds its invites
  @@index([mapId])
  @@index([tripId])
  @@index([invitedById])
  @@map("share_invite")
}

// ── Countries visited ────────────────────────────────────────────────────────

enum VisitStatus {
  VISITED
  LIVED
  WANT_TO_GO
}

enum VisitSource {
  MANUAL // ticked in the country list
  PHOTO // a photo was placed in this country
  TRIP // a completed trip stopped here
}

// Replaces the hardcoded visited flags. Stats (countries, continents, photos,
// landmarks) are counted from these tables, never stored.
model CountryVisit {
  mapId       String
  map         TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  countryCode String    @db.Char(2)
  country     Country   @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  status         VisitStatus @default(VISITED)
  source         VisitSource @default(MANUAL)
  firstVisitedOn DateTime?   @db.Date
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([mapId, countryCode])
  // No index on countryCode alone: nothing looks visits up by country, and
  // countries are never deleted
  @@map("country_visit")
}

// ── Trips (planned and completed use the same model) ─────────────────────────

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Trip {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TripStatus @default(PLANNED)
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date

  mapId String
  map   TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  coverPhotoId String?
  coverPhoto   Photo?  @relation("TripCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  // A single trip can be shared without sharing the whole map
  linkAccess LinkAccess @default(RESTRICTED)
  shareCode  String     @unique

  travellers TripTraveller[] // who went (or is going)
  members    TripMember[]
  stops      TripStop[]
  photos     Photo[]         @relation("TripPhotos")
  invites    ShareInvite[]
  // Other people's maps this trip is shown on (a group trip's "Add to my map")
  mapLinks   TripMap[]
  moments    Moment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mapId, startDate])
  // Foreign keys: without these, the SET NULL for each deleted photo or user
  // scans every trip (deleting a 20k-photo map took 148 s, 1.9 s with them)
  @@index([coverPhotoId])
  @@index([createdById])
  @@map("trip")
}

// People added to one trip only, e.g. friends planning it together
model TripMember {
  tripId String
  trip   Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   ShareRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tripId, userId])
  @@index([userId])
  @@map("trip_member")
}

// A group trip shown on someone else's map ("Add to my map", docs/API.md "Group
// trips"). Nothing is copied: the trip, its stops and photos stay on the organiser's
// map. The trip shows in this map's trips (counted in its stats), and completing it
// marks its stops' countries visited here too. Taking it off, or leaving the trip,
// keeps the visits already marked.
model TripMap {
  tripId String
  trip   Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  mapId  String
  map    TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  // Who added it (they, or the map's owner, can take it off). Leaving the trip removes
  // the links that person added.
  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now())

  @@id([tripId, mapId])
  // A map's linked trips; the PK serves a trip's
  @@index([mapId])
  // Foreign key: SET NULL when that account is deleted
  @@index([addedById])
  @@map("trip_map")
}

// Which of the map's travellers went on a trip. Per-person stats ("Sarah: 18
// countries") come from these trips.
model TripTraveller {
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travellerId String
  traveller   Traveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)

  @@id([tripId, travellerId])
  @@index([travellerId])
  @@map("trip_traveller")
}

model TripStop {
  id       String @id @default(uuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position Int // order within the trip

  countryCode String    @db.Char(2)
  country     Country   @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  // The UK nation (XE, XC, XW, XI) it was in when the map's split was last turned off,
  // so turning it on again puts it back there; null otherwise (services/travel/ukNations.js)
  ukNation    String?   @db.Char(2)
  landmarkId  String?
  landmark    Landmark? @relation(fields: [landmarkId], references: [id], onDelete: SetNull)
  placeName   String? // a town or place that isn't a seeded landmark

  arriveOn DateTime? @db.Date
  leaveOn  DateTime? @db.Date
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, position])
  @@map("trip_stop")
}

// ── Photos ───────────────────────────────────────────────────────────────────

model Photo {
  id String @id @default(uuid())

  mapId String
  map   TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  // Deleting an account deletes the photos that person uploaded
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  tripId String?
  trip   Trip?   @relation("TripPhotos", fields: [tripId], references: [id], onDelete: SetNull)

  countryCode String?  @db.Char(2)
  country     Country? @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  // The UK nation (XE, XC, XW, XI) it was in when the map's split was last turned off,
  // so turning it on again puts it back there; null otherwise (services/travel/ukNations.js)
  ukNation    String?   @db.Char(2)

  caption String?
  takenAt DateTime?

  // Read from the file's EXIF before upload. Shown only to the owner and
  // editors, and never left inside the files people view.
  latitude  Float?
  longitude Float?

  // A photo, or a First Class video (docs/API.md, "Videos"): a video's file is its ORIGINAL
  // variant (location metadata overwritten in the browser), its THUMB and DISPLAY are
  // poster frames, and it has a length. CHECKs: a video has `durationS` (a photo none) and
  // no latitude or longitude.
  kind      PhotoKind @default(PHOTO)
  durationS Int?

  // A video lives in Cloudflare Stream (docs/API.md "Videos"), which converts it so every
  // browser plays it: its Stream id, where the conversion has got to, and its size (it
  // counts towards the storage safety net). A video has no PhotoVariants. CHECK
  // photo_video_stream: a video has all of these, a photo none.
  streamUid  String?     @unique
  videoState VideoState?
  videoBytes Int?

  // When it was taken, or when it was uploaded if the file had no date: the slideshows'
  // order and the dated goals. Always takenAt ?? createdAt (set by domain/photos.js).
  shotAt DateTime @default(now())

  width  Int
  height Int

  // Kept for editors, never shown to viewers (replaces the old "hidden
  // hashtags" idea)
  hidden Boolean @default(false)

  // Where the photo sits in its galleries, smallest first: its country's on the map
  // (the unplaced photos, with no country, are one gallery too), and its trip's.
  // Editors drag photos to rearrange them; a new photo goes first. Moving one photo
  // writes only its own position (between its new neighbours): utils/photoOrder.js.
  countryPosition Float @default(0)
  tripPosition    Float @default(0)

  variants     PhotoVariant[]
  landmarks    PhotoLandmark[]
  coverOf      Trip[]            @relation("TripCover")
  moments      MomentPhoto[]
  // Passport stamps showing this photo
  stampCovers  LandmarkCover[]
  // The monthly themes it's entered in
  themeEntries PhotoThemeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The photo lists' order, keyset on id: the whole map's newest upload first (the
  // hover postcards), a country's and a trip's in their own order. They also serve
  // the photo counts.
  @@index([mapId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tripId, tripPosition, id])
  @@index([mapId, countryCode, countryPosition, id])
  // The worldwide slideshow, in the order the photos were taken
  @@index([mapId, shotAt, id])
  @@index([uploaderId])
  @@map("photo")
}

enum PhotoKind {
  PHOTO
  VIDEO
}

// A video's conversion in Cloudflare Stream: shown to viewers only when READY
enum VideoState {
  PROCESSING
  READY
  FAILED
}

enum PhotoSize {
  THUMB // ~400px, location data removed
  DISPLAY // ~1600px, location data removed
  ORIGINAL // the file as uploaded; owner and editors can download it (Business and First Class maps)
  PRINT // ~2400px JPEG, location data removed: the best copy an Economy map keeps
}

// Each size is its own file in the private bucket, through MediaItem, so the
// dummy's confirm-upload size checks and orphan clean-up keep working.
model PhotoVariant {
  photoId String
  photo   Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  size    PhotoSize
  mediaId String    @unique
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  width   Int
  height  Int

  @@id([photoId, size])
  @@map("photo_variant")
}

enum MatchSource {
  GPS // the photo was taken within the landmark's radius
  MANUAL // the user picked the landmark
}

model PhotoLandmark {
  photoId     String
  photo       Photo       @relation(fields: [photoId], references: [id], onDelete: Cascade)
  landmarkId  String
  landmark    Landmark    @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  source      MatchSource
  // How far from the landmark the photo was taken (GPS matches)
  distanceM   Int?
  // GPS matches are suggestions until the user confirms them
  confirmed   Boolean     @default(false)
  // When it was confirmed (the passport stamp earned); null exactly while unconfirmed
  // (CHECK photo_landmark_confirmed_at)
  confirmedAt DateTime?

  // The photo's map, copied here (a photo never changes map), so the passport and the
  // landmark stat read this table alone instead of joining every photo on the map
  mapId String
  map   TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  // The stamp that shows this match's photo
  coverOf LandmarkCover[]

  createdAt DateTime @default(now())

  @@id([photoId, landmarkId])
  @@index([landmarkId])
  @@index([mapId, landmarkId])
  @@map("photo_landmark")
}

// ── Moments (life events and notes on the map; docs/API.md "Moments") ────────
// "Moment", not "event": AppEvent is the app's log.

// How much of `happenedOn` is known. A month or a year is stored as its first day.
enum DatePrecision {
  DAY
  MONTH
  YEAR
}

// Something that happened in a country (or a special place): "We had our baby in
// Paris", "We saw a volcano". Optionally at a landmark or a named place, on a trip,
// about some of the map's travellers, with some of the map's photos (nothing is
// uploaded). Never coordinates. Hidden ones are for editors only, like hidden photos.
model Moment {
  id    String    @id @default(uuid())
  mapId String
  map   TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  // Checked in code against src/utils/constants/momentKinds.js (no enum, so a new kind
  // needs no migration)
  kind  String
  title String
  text  String?

  // Both null for an undated note, both set otherwise (a CHECK in the migration)
  happenedOn    DateTime?      @db.Date
  datePrecision DatePrecision?

  countryCode String    @db.Char(2)
  country     Country   @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  // The UK nation (XE, XC, XW, XI) it was in when the map's split was last turned off,
  // so turning it on again puts it back there; null otherwise (services/travel/ukNations.js)
  ukNation    String?   @db.Char(2)
  // In the moment's country (checked in code)
  landmarkId  String?
  landmark    Landmark? @relation(fields: [landmarkId], references: [id], onDelete: SetNull)
  placeName   String?

  // A pin on the map (16 Nov 2026): the exact spot, in the moment's country (checked in
  // code); both or neither, in range (CHECK moment_spot). The owner and editors always see
  // it; viewers and share links only when `spotShared` (chosen when it's pinned, off by
  // default; never true without a spot)
  latitude   Float?
  longitude  Float?
  spotShared Boolean @default(false)

  // One of the map's own trips: its trip-only editors may change the moment
  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  hidden Boolean @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  travellers MomentTraveller[]
  photos     MomentPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The lists: the map's moments in date order, and a country's
  @@index([mapId, happenedOn])
  @@index([mapId, countryCode, happenedOn])
  // Foreign keys: a trip's moments (and its SET NULL), a landmark's, an account's
  @@index([tripId])
  @@index([landmarkId])
  @@index([createdById])
  @@map("moment")
}

// Which of the map's travellers a moment is about
model MomentTraveller {
  momentId    String
  moment      Moment    @relation(fields: [momentId], references: [id], onDelete: Cascade)
  travellerId String
  traveller   Traveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)

  @@id([momentId, travellerId])
  @@index([travellerId])
  @@map("moment_traveller")
}

// Photos already on the map, chosen for a moment, in order
model MomentPhoto {
  momentId String
  moment   Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  photoId  String
  photo    Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@id([momentId, photoId])
  // Foreign key: deleting a photo (or a whole map's) finds its moments
  @@index([photoId])
  @@map("moment_photo")
}

// ── Media (from the dummy; blog links removed, photo variants added) ─────────

enum MediaKind {
  IMAGE
  VIDEO
  FILE
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model MediaItem {
  id               String          @id @default(uuid())
  key              String          @unique
  resource         String
  kind             MediaKind
  visibility       MediaVisibility
  contentType      String
  bytes            Int?
  originalFilename String?

  // Null for anonymous uploads (contact form attachments)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  usedAsAvatarBy AvatarMediaItem?
  photoVariant   PhotoVariant?

  createdAt DateTime @default(now())

  @@index([resource])
  // The per-user cap on unfinished uploads counts by owner and age; it also serves
  // the owner foreign key (SET NULL when a user is deleted)
  @@index([ownerId, createdAt])
  @@map("media_item")
}

model AvatarMediaItem {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaId String    @unique
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  alt    String?
  focalX Float?
  focalY Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("avatar_media_item")
}

// ── Contact (trimmed: no phone or postal address) ────────────────────────────

model ContactForm {
  id      String @id @default(uuid())
  name    String
  email   String
  message String

  // Optional screenshot (MediaItem.key)
  imageKey String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  // The cron's "no form uses this file" check and the contact image rules look up by key
  @@index([imageKey])
  @@map("contact_form")
}

// ── Passport, badges, goals and promo codes ─────────────────────────────────

// The passport (docs/API.md, "Passport")

// The photo a passport stamp shows, picked by the owner or an editor. Without one, the
// stamp shows the landmark's earliest confirmed photo. It points at the match itself, so
// removing the match (or the photo) removes the choice.
model LandmarkCover {
  mapId      String
  map        TravelMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  landmarkId String
  landmark   Landmark      @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  photoId    String
  photo      Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)
  match      PhotoLandmark @relation(fields: [photoId, landmarkId], references: [photoId, landmarkId], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@id([mapId, landmarkId])
  // Foreign keys: the cascades from a photo, a match and a landmark
  @@index([photoId, landmarkId])
  @@index([landmarkId])
  @@map("landmark_cover")
}

// Monthly photo themes (docs/API.md, "Photo themes"; docs/FEATURE-PLAN.md "Monthly photo
// themes"): one theme a calendar month (UTC), set in advance by an admin. While a theme runs,
// a map's editors enter any of the map's photos (from any date); the entries are the
// theme's album on that map, seen by whoever can see the map. Never a public gallery.

// CHECK photo_theme_first_of_month: `month` is the 1st of its month
model PhotoTheme {
  id      String            @id @default(uuid())
  // The month it runs, as its first day (UTC)
  month   DateTime          @unique @db.Date
  title   String
  blurb   String?
  entries PhotoThemeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photo_theme")
}

// A photo entered in a theme. `mapId` is the photo's map (a photo never changes map), so a
// map's albums and the theme badges read this table alone.
model PhotoThemeEntry {
  themeId     String
  theme       PhotoTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  photoId     String
  photo       Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  mapId       String
  map         TravelMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  enteredById String?
  enteredBy   User?      @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  enteredAt   DateTime   @default(now())

  @@id([themeId, photoId])
  // A map's album for a theme, newest entry first, and its counts
  @@index([mapId, themeId, enteredAt(sort: Desc), photoId(sort: Desc)])
  @@index([photoId])
  @@index([enteredById])
  @@map("photo_theme_entry")
}

// Friends challenges (docs/API.md, "Friends challenges"; docs/FEATURE-PLAN.md "Friends
// challenges"): a measure counted between two dates, among friends who join by a link.
// Each person picks which of their maps counts; the others see names and counts only.

enum ChallengeMeasure {
  NEW_COUNTRIES // countries whose first photo on the map was taken in the dates
  COUNTRIES // countries with a photo taken in the dates
  LANDMARKS // landmarks stamped from photos taken in the dates
  THEME_PHOTOS // photos entered in the monthly themes in the dates
}

// CHECKs: dates in order, at most two years long; target 1–500 or none; title 1–80
model FriendChallenge {
  id          String                 @id @default(uuid())
  title       String
  measure     ChallengeMeasure
  // The first and last days counted (UTC), both included
  startsOn    DateTime               @db.Date
  endsOn      DateTime               @db.Date
  // "First to 5": optional
  target      Int?
  // The join link's code (utils/shareCodes.js); a reset gives a new one
  joinCode    String                 @unique
  createdById String?
  createdBy   User?                  @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries     FriendChallengeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@map("friend_challenge")
}

// Someone in a challenge, and the map that counts for them (one they own or edit; null
// once that map is gone, until they pick another)
model FriendChallengeEntry {
  challengeId String
  challenge   FriendChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId       String?
  map         TravelMap?      @relation(fields: [mapId], references: [id], onDelete: SetNull)
  joinedAt    DateTime        @default(now())

  @@id([challengeId, userId])
  @@index([userId])
  @@index([mapId])
  @@map("friend_challenge_entry")
}

// Badges and goals (docs/API.md, "Badges and goals")

// A site badge a map has earned (utils/badges.js lists them). Awarded when the owner or
// an editor loads the map's badges, and never taken back.
model BadgeAward {
  mapId    String
  map      TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  badgeKey String
  earnedAt DateTime  @default(now())

  @@id([mapId, badgeKey])
  @@map("badge_award")
}

enum GoalKind {
  COUNTRY_COUNT // `target` countries
  COUNTRY_LIST // every country in `countryCodes` (a bucket list)
  REGION // every country in `region` (a continent or a region in utils/constants/regions.js)
  LANDMARK_COUNT // `target` passport stamps
}

// A personal goal on a map. With a `deadline`, only what has a photo taken by then counts
// (a hand-ticked country has no date). `achievedAt` is set the first time the owner or an
// editor loads it met; changing what it asks clears it. CHECK goal_shape: each kind has
// exactly its own fields.
model Goal {
  id    String    @id @default(uuid())
  mapId String
  map   TravelMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  kind         GoalKind
  // The person's own words ("30 before 30"); the app words it from the kind otherwise
  title        String?
  target       Int?
  countryCodes String[]
  region       String?
  deadline     DateTime? @db.Date
  achievedAt   DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mapId, createdAt])
  // Foreign key: SET NULL when the account is deleted
  @@index([createdById])
  @@map("goal")
}

// Influencer codes (docs/API.md, "Promo codes"): a sign-up link or code per creator, so
// sign-ups can be counted per code. Every code gives the same offer, set in code
// (utils/promoCodes.js, 16 Nov 2026): the follower's first month free on the paid plan
// they choose, as a Stripe trial with a card (Profile.promoTrialUsedAt).
model PromoCode {
  id    String @id @default(uuid())
  // Upper case letters and digits, e.g. SAMTRAVELS (utils/promoCodes.js)
  code  String @unique
  // Who it's for, e.g. "Sam Travels (YouTube)"; admins only
  label String

  active  Boolean   @default(true)
  // No more sign-ups with it after this many, or after this time
  maxUses Int?
  endsAt  DateTime?

  // A code that gives a paid plan for life (REGULAR or PREMIUM, CHECK promo_code_free_plan;
  // the user's own codes, 17 Nov 2026): signing up with it gives the account a complimentary
  // membership that never ends (utils/promoCodes.js). Null: the usual offer, the first month
  // free. Set when the code is made, never changed.
  freePlan Plan?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  profiles Profile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key: SET NULL when the admin's account is deleted
  @@index([createdById])
  @@map("promo_code")
}

// ── Travel offers: ad cards and the Travel Desk ────────────────────────────────

enum OfferKind {
  HOTEL
  TOUR
  FLIGHT
  ESIM
  INSURANCE
  LUGGAGE
  CAR_HIRE
  OTHER
  // A photo printer (the "Print or download" dialog; FEATURE-PLAN.md "Printing")
  PRINTS
}

// Where an offer may show: every 12th or 24th tile of a photo gallery, the end of a
// slideshow, the public country pages, the Travel Desk (only when asked for), and the
// "Print or download" dialog (PRINT: the print partners, under the download)
enum OfferPlacement {
  GALLERY
  SLIDESHOW
  COUNTRY_PAGE
  TRAVEL_DESK
  PRINT
}

// A partner's offer (docs/API.md, "Travel offers"), imported from a JSON file by its
// `key` (utils/offers.js; `npm run db:offers -- <file>` or the admin's import), or made
// on the admin page. Shown as our own card; a click goes through GET /go/:offerId, which
// counts it (OfferClickDaily) and redirects to `url` with its placeholders filled.
// CHECKs: weight 1–100, at least one placement, startsAt not after endsAt.
model AffiliateOffer {
  id  String @id @default(uuid())
  // The import file's id for it, e.g. "example-stays-jp": importing again updates the row
  key String @unique

  partner String
  kind    OfferKind
  // "Hotels in Kyoto"; the card's one line
  title   String
  blurb   String?

  // The country it's for; null for a general offer (insurance, eSIMs, luggage)
  countryCode String?  @db.Char(2)
  country     Country? @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  placements OfferPlacement[]

  // The partner's link, https only. May hold {destination}, {country}, {checkin} and
  // {checkout}, filled at the click from what the card knew (a planned trip's dates)
  url      String
  // A picture in the public bucket (e.g. a country poster); the card draws an
  // illustration of its kind without one
  imageKey String?
  // How often it's picked among the offers that fit a slot
  weight   Int     @default(1)

  active   Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  clicks OfferClickDaily[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("affiliate_offer")
}

// Clicks, counted per offer, UTC day and placement, and nothing else: no person, map,
// share code or time of day (docs/FEATURE-PLAN.md, "Ads")
model OfferClickDaily {
  offerId   String
  offer     AffiliateOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  day       DateTime       @db.Date
  placement OfferPlacement
  count     Int            @default(0)

  @@id([offerId, day, placement])
  @@map("offer_click_daily")
}

// ── Plans and payments (docs/API.md, "Plans and billing") ────────────────────
// Names, prices and limits live in src/utils/constants/plans.js, never here. The
// plan in force is computed (utils/plans.js): the best of a counting subscription
// and an active grant, else FREE.

enum Plan {
  FREE // Economy
  REGULAR // Business
  PREMIUM // First Class
}

enum BillingInterval {
  MONTH
  YEAR
}

// One per account: its Stripe customer and subscription, written by the webhook.
// The subscription has a plan line (none on FREE) and an extra-map line whose
// quantity is the number of extra maps paid for.
model Subscription {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique

  // FREE when the subscription only pays for extra maps
  plan              Plan             @default(FREE)
  interval          BillingInterval?
  // Stripe's status (active, trialing, past_due count; canceled, unpaid... don't)
  status            String?
  // A CHECK in the migration keeps it 0 or more
  extraMaps         Int              @default(0)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

// A complimentary membership: a plan for a set time, given by an admin
model PlanGrant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("PlanGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan

  startsAt DateTime @default(now())
  endsAt   DateTime
  reason   String?

  grantedById String?
  grantedBy   User?   @relation("PlanGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // The plan in force: a user's grants that haven't ended
  @@index([userId, endsAt])
  // Foreign key: SET NULL when the admin's account is deleted
  @@index([grantedById])
  @@map("plan_grant")
}

// Webhook idempotency: Stripe retries, so each event id is applied once. The
// daily cron removes rows over 90 days old.
model StripeEvent {
  id          String   @id // Stripe's event id (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("stripe_event")
}

// ── Rate limiting (from NextDummy: shared across Vercel instances) ───────────

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit")
}

// better-auth's own limiter for /api/auth/* (auth.js: rateLimit.storage 'database',
// modelName 'authRateLimit'). Its shape is better-auth's: key = "<ip>|<path>",
// lastRequest in epoch ms. better-auth prunes old rows itself.
model AuthRateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("auth_rate_limit")
}

// ── Audit log (unchanged from the dummy) ─────────────────────────────────────

enum AppEventLevel {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AppEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

model AppEvent {
  id         String         @id @default(uuid())
  level      AppEventLevel  @default(INFO)
  status     AppEventStatus @default(OPEN)
  important  Boolean        @default(false)
  domain     String
  action     String
  message    String
  statusCode Int?
  path       String?
  method     String?
  stack      String?
  requestId  String?
  metadata   Json?

  actor    User?   @relation("AppEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId  String?
  target   User?   @relation("AppEventTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetId String?

  createdAt DateTime @default(now())

  // The admin list (newest first, optionally by level), retention by age, and
  // the SET NULL when a user is deleted
  @@index([createdAt])
  @@index([level, createdAt])
  @@index([actorId])
  @@index([targetId])
  @@index([requestId])
  @@map("app_event")
}
