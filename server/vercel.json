{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "prisma/**",
          "node_modules/.prisma/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/server.js" }
  ],
  "crons": [
    { "path": "/api/media-services/cron/cleanup-orphans", "schedule": "0 4 * * *" },
    { "path": "/api/emails/on-this-day/cron", "schedule": "0 8 * * *" }
  ]
}