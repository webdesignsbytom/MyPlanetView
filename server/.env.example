PORT=4000
NODE_ENV=development
# Only used in the startup log line (default http://localhost:)
HTTP_URL=http://localhost:

# Seed guard (true only in production)
IS_PRODUCTION_DATABASE=false

# Database
# DATABASE_URL: what the app queries through. In production (Vercel) use the provider's
# POOLED, transaction-mode URL (Neon: the "-pooler" host; Supabase: the pooler on port 6543),
# because every function instance opens its own connections. Locally, the plain URL is fine.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/myplanetview?schema=public&sslmode=disable"
# DIRECT_DATABASE_URL: the DIRECT (unpooled) URL, used only by the Prisma CLI (migrate) through
# prisma.config.ts. Migrations need a direct session, not a transaction pooler.
DIRECT_DATABASE_URL="postgresql://postgres:admin@localhost:5432/myplanetview?schema=public&sslmode=disable"
SHADOW_DATABASE_URL="postgresql://postgres:admin@localhost:5432/shadowdb?schema=public&sslmode=disable"
# Connections per function instance (src/prisma.js). Default 5 when empty.
DB_POOL_MAX=5

# Auth
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:4000"

# Comma-separated: every site address allowed to call the API and sign in (CORS and
# better-auth's trusted origins): localhost, the temporary Netlify site, the bare domain.
# www. is a different origin.
FRONTEND_ORIGIN="http://localhost:5173,https://<your-site>.netlify.app,https://myplanetview.example"

# Cron (Vercel sends it as a Bearer token)
CRON_SECRET=

# Email (Resend, resend.com). Production refuses to start without both; locally the server
# starts anyway and logs each email (with its link) instead of sending it.
RESEND_API_KEY=
# The address every email comes from, on a domain verified in Resend (e.g. hello@myplanetview.com).
# Until the domain is verified: onboarding@resend.dev, which only delivers to your Resend account's address.
EMAIL_FROM=
# Where contact-form notifications are delivered (spelled RECIEVER, as in the code)
CONTACT_ADMIN_RECIEVER_EMAIL=

# File storage (public): avatars, contact-form images and other site images.
STORAGE_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=my-planet-view-public
STORAGE_ACCESS_KEY=key
STORAGE_SECRET_KEY=key
STORAGE_PUBLIC_HOST=https://pub-<id>.r2.dev

# File storage (private): travel photos, served only through signed URLs. Never public.
STORAGE_PRIVATE_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
STORAGE_PRIVATE_REGION=auto
STORAGE_PRIVATE_BUCKET=my-planet-view-private
STORAGE_PRIVATE_ACCESS_KEY=key
STORAGE_PRIVATE_SECRET_KEY=key
