PORT=4000
NODE_ENV=development

# Seed guard (true only in production)
IS_PRODUCTION_DATABASE=false

# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/projectworld?schema=public&sslmode=disable"
DIRECT_DATABASE_URL=
SHADOW_DATABASE_URL="postgresql://postgres:admin@localhost:5432/shadowdb?schema=public&sslmode=disable"
DB_POOL_MAX=

# Auth
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:4000"

# Comma-separated: the site's bare domain plus localhost (www. is a different origin)
FRONTEND_ORIGIN="http://localhost:5173,https://projectworld.example"

# Cron (Vercel sends it as a Bearer token)
CRON_SECRET=

# Emails
# Email connection
EMAIL_HOST="mail.domain.com"
EMAIL_PORT=465
# User email
USER_ADMIN_EMAIL="email@domain.com"
USER_ADMIN_PASS="password"
# Verify email
USER_VERIFY_EMAIL="email@domain.com"
USER_VERIFY_PASS="password"
# Reset email
USER_RESET_EMAIL="email@domain.com"
USER_RESET_PASS="password"
# Contact
CONTACT_ADMIN_EMAIL="email@domain.com"
CONTACT_ADMIN_PASS="password"
CONTACT_ADMIN_RECIEVER_EMAIL="user@domain.com"

# File storage (any S3-compatible host). Cloudflare R2 shown: endpoint is
# https://<account-id>.r2.cloudflarestorage.com, region "auto", and the public
# host is the bucket's custom domain (r2.dev is rate-limited, for development only).
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=projectworld-public
STORAGE_ACCESS_KEY=key
STORAGE_SECRET_KEY=key
STORAGE_PUBLIC_HOST=https://media.projectworld.example

# File storage (private): travel photos, served only through signed URLs.
# Each setting falls back to its STORAGE_* twin; needs CORS for the site (setPrivateBucketCors.js)
STORAGE_PRIVATE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_PRIVATE_REGION=auto
STORAGE_PRIVATE_BUCKET=projectworld-private
STORAGE_PRIVATE_ACCESS_KEY=key
STORAGE_PRIVATE_SECRET_KEY=key
